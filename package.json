{
  "name": "sisforvm",
  "version": "2.0.0",
  "private": true,
  "description": "FORVM - Simulador de custos de importação (Conta e Ordem)",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "prestart": "vite build",
    "start":"node --disable-warning=ExperimentalWarning src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
